{
  "governance-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/pre-tool-guard.ps1"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "powershell -NoProfile -Command \"Write-Host 'Verificando checklist SDD antes do encerramento...'\""
      }
    ]
  }
}
