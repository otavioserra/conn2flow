# Copy to .env only when overriding local PostgreSQL test defaults.
# Never commit real credentials or reuse production values here.

C2F_PGSQL_APP_PORT=8085
C2F_PGSQL_PORT=5433
C2F_PGADMIN_PORT=8083

C2F_PGSQL_DATABASE=conn2flow
C2F_PGSQL_USERNAME=conn2flow_user
C2F_PGSQL_PASSWORD=conn2flow_pass
C2F_PGSQL_SCHEMA=public

C2F_PGADMIN_EMAIL=admin@conn2flow.local
C2F_PGADMIN_PASSWORD=change-me-local
