{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/pre-tool-guard.ps1"
          }
        ]
      }
    ]
  }
}
